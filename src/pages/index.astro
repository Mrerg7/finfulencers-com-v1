---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Inquire from '../components/Inquire.astro';
import { buyerFaqs } from '../data/faq';
import { uses } from '../data/site';

const title = 'finfulencers.com for Sale | Finance Influencer Domain';
const description =
  'finfulencers.com is for sale. A brandable .com for media brands, agencies, and fintech in the finfluencer category. Email sales@desertrich.com.';

const previewFaqs = buyerFaqs.slice(0, 4);
---

<Layout title={title} description={description} modified="2026-09-27">
  <Header />

  <main id="main">
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_10%_-10%,rgba(12,142,233,0.16),transparent),radial-gradient(ellipse_50%_40%_at_100%_0%,rgba(245,158,11,0.12),transparent)]"></div>
      <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 sm:px-6 sm:py-20 lg:grid-cols-[1.15fr_0.85fr] lg:px-8 lg:py-24">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-gold-100 bg-gold-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-gold-900">
            <span class="h-1.5 w-1.5 rounded-full bg-gold-600" aria-hidden="true"></span>
            Premium .com · Available
          </p>
          <h1 class="mt-5 font-serif text-4xl leading-[0.95] tracking-tight text-slate-950 min-[420px]:text-5xl sm:text-6xl lg:text-7xl">
            <span class="block sm:inline">finfulencers</span><span class="text-brand-800 sm:inline">.com</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-700 sm:text-xl">
            The brandable .com beside the financial-influencer category. Built for a media brand, agency, newsletter, or fintech product that wants a name people already connect with money and attention.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#inquire" class="inline-flex min-h-12 items-center justify-center rounded-full bg-brand-800 px-6 text-base font-semibold text-white hover:bg-brand-900">
              Make an offer
            </a>
            <a href="/acquire/" class="inline-flex min-h-12 items-center justify-center rounded-full border border-slate-300 bg-white px-6 text-base font-semibold text-slate-800 hover:border-slate-400">
              See what transfers
            </a>
          </div>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-slate-500">
            Category spelling in the press is usually “finfluencer.” This domain is the coined brand
            <strong class="font-semibold text-slate-700">finfulencers.com</strong>.
            <a href="/faq/#spelling" class="font-medium text-brand-800 underline decoration-brand-200 underline-offset-4">Why that matters</a>
          </p>
        </div>

        <aside class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xl shadow-slate-900/5 sm:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Domain dossier</p>
          <p class="mt-2 font-serif text-3xl tracking-tight text-slate-950">finfulencers.com</p>
          <dl class="mt-6 divide-y divide-slate-100 text-sm">
            <div class="flex items-baseline justify-between gap-4 py-3">
              <dt class="text-slate-500">Status</dt>
              <dd class="font-semibold text-emerald-800">Available</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-3">
              <dt class="text-slate-500">Extension</dt>
              <dd class="font-semibold text-slate-950">.com</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-3">
              <dt class="text-slate-500">Length</dt>
              <dd class="font-semibold text-slate-950">13 letters</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-3">
              <dt class="text-slate-500">Category</dt>
              <dd class="text-right font-semibold text-slate-950">Finance creators</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-3">
              <dt class="text-slate-500">Included</dt>
              <dd class="text-right font-semibold text-slate-950">Domain name only</dd>
            </div>
          </dl>
          <a href="#inquire" class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-full bg-slate-950 text-sm font-semibold text-white hover:bg-slate-800">
            Request the price
          </a>
          <p class="mt-3 text-center text-xs text-slate-500">Confidential · sales@desertrich.com</p>
        </aside>
      </div>
    </section>

    <section class="border-y border-slate-200 bg-white" aria-label="Domain facts">
      <dl class="mx-auto grid max-w-6xl grid-cols-2 gap-px bg-slate-200 md:grid-cols-4">
        <div class="bg-white px-4 py-6 sm:px-6">
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Asset</dt>
          <dd class="mt-1 text-base font-semibold text-slate-950">Exact .com</dd>
        </div>
        <div class="bg-white px-4 py-6 sm:px-6">
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Buyer</dt>
          <dd class="mt-1 text-base font-semibold text-slate-950">Brand, not a blog</dd>
        </div>
        <div class="bg-white px-4 py-6 sm:px-6">
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Transfer</dt>
          <dd class="mt-1 text-base font-semibold text-slate-950">Auth code + escrow</dd>
        </div>
        <div class="bg-white px-4 py-6 sm:px-6">
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Audience</dt>
          <dd class="mt-1 text-base font-semibold text-slate-950">Not included</dd>
        </div>
      </dl>
    </section>

    <section id="uses" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="max-w-2xl">
        <h2 class="font-serif text-3xl tracking-tight text-slate-950 sm:text-4xl">Who the name is for</h2>
        <p class="mt-4 text-lg leading-relaxed text-slate-600">
          finfulencers.com is a front door, not a going concern. It fits an operator who will put a real brand behind the category.
          <a href="/acquire/" class="font-medium text-brand-800 underline decoration-brand-200 underline-offset-4">Read the acquisition terms</a>.
        </p>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          uses.map((item) => (
            <a href={`/acquire/#${item.id}`} class="block rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-brand-200 hover:shadow-md">
              <h3 class="text-lg font-semibold text-slate-950">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.text}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="bg-white py-16 sm:py-20">
      <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
        <div>
          <h2 class="font-serif text-3xl tracking-tight text-slate-950 sm:text-4xl">The category this name sits next to</h2>
          <p class="mt-4 text-lg leading-relaxed text-slate-600">
            A finfluencer is a creator who explains money — budgets, debt, markets, independence — in the voice of social media rather than a bank brochure.
            The word is mainstream enough that the
            <a href="https://www.fca.org.uk/news/press-releases/fca-cracks-down-illegal-finfluencers" class="font-medium text-brand-800 underline decoration-brand-200 underline-offset-4" rel="noopener noreferrer">UK Financial Conduct Authority</a>
            and
            <a href="https://www.finra.org/rules-guidance/key-topics/social-media" class="font-medium text-brand-800 underline decoration-brand-200 underline-offset-4" rel="noopener noreferrer">FINRA</a>
            both use it.
          </p>
          <p class="mt-4 text-lg leading-relaxed text-slate-600">
            In October 2024 the FCA said nearly two-thirds of 18- to 29-year-olds follow social-media influencers, 74% of those followers trusted their advice, and 9 in 10 young followers had been encouraged to change a financial behaviour. That attention is why a clean .com in the neighborhood is worth owning — and why the operator still has to publish responsibly.
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href="/what-is-a-finfluencer/" class="inline-flex min-h-11 items-center font-semibold text-brand-800 underline decoration-brand-200 underline-offset-4">What is a finfluencer?</a>
            <a href="/finfluencer-platforms/" class="inline-flex min-h-11 items-center font-semibold text-brand-800 underline decoration-brand-200 underline-offset-4">Where they publish</a>
          </div>
        </div>
        <div class="grid gap-4">
          <article class="rounded-2xl border border-slate-200 bg-[#f6f4ef] p-6">
            <h3 class="text-lg font-semibold text-slate-950">Personal, not institutional</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">Payoff stories, first homes, and “here is my brokerage screen” outperform a PDF from a wealth desk. The audience shows up for a person.</p>
          </article>
          <article class="rounded-2xl border border-slate-200 bg-[#f6f4ef] p-6">
            <h3 class="text-lg font-semibold text-slate-950">Short-form, then owned media</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">TikTok, Reels, and YouTube find the audience. Newsletters and a real domain keep it. The .com is the asset the algorithm cannot revoke.</p>
          </article>
          <article class="rounded-2xl border border-slate-200 bg-[#f6f4ef] p-6">
            <h3 class="text-lg font-semibold text-slate-950">Regulators are already in the replies</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">Unauthorized promotions have produced FCA prosecutions. A buyer who treats the name as a compliance-aware media brand will outlast one who treats it as a tip account.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="max-w-2xl">
        <h2 class="font-serif text-3xl tracking-tight text-slate-950 sm:text-4xl">How a sale works</h2>
        <p class="mt-4 text-lg text-slate-600">Three steps. No account on this site. No audience is bundled in.</p>
      </div>
      <ol class="mt-10 grid gap-4 md:grid-cols-3">
        <li class="rounded-2xl border border-slate-200 bg-white p-6">
          <p class="font-serif text-3xl text-brand-800">01</p>
          <h3 class="mt-3 text-lg font-semibold text-slate-950">You write</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Send who you are, what you would build, and a number if you have one. Brokers should name their principal.</p>
        </li>
        <li class="rounded-2xl border border-slate-200 bg-white p-6">
          <p class="font-serif text-3xl text-brand-800">02</p>
          <h3 class="mt-3 text-lg font-semibold text-slate-950">Terms, in private</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">The seller confirms availability and replies with price and terms. The negotiation is not posted here.</p>
        </li>
        <li class="rounded-2xl border border-slate-200 bg-white p-6">
          <p class="font-serif text-3xl text-brand-800">03</p>
          <h3 class="mt-3 text-lg font-semibold text-slate-950">Escrow, then the code</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Funds can sit with an escrow agent. You receive the authorization code and move the name to your registrar.</p>
        </li>
      </ol>
    </section>

    <section class="bg-white py-16 sm:py-20" aria-labelledby="faq-heading">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
        <div>
          <h2 id="faq-heading" class="font-serif text-3xl tracking-tight text-slate-950 sm:text-4xl">Before you write</h2>
          <p class="mt-4 text-lg text-slate-600">Straight answers. The long list lives on the FAQ.</p>
          <a href="/faq/" class="mt-6 inline-flex min-h-11 items-center font-semibold text-brand-800 underline decoration-brand-200 underline-offset-4">All buyer questions</a>
        </div>
        <div class="divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-[#f6f4ef]">
          {
            previewFaqs.map((item) => (
              <details class="group px-5 py-1">
                <summary class="flex min-h-12 cursor-pointer items-center justify-between gap-4 py-3 text-left text-base font-semibold text-slate-950">
                  {item.question}
                  <span class="text-slate-400 group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <p class="pb-4 text-sm leading-relaxed text-slate-600">{item.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <Inquire />
    </section>
  </main>

  <Footer />
</Layout>
