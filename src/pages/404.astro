---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page not found | Finfulencers"
  description="That page is not on finfulencers.com. The domain itself is for sale."
  noindex={true}
>
  <Header />
  <main id="main" class="flex flex-1 items-center px-4 py-20">
    <div class="mx-auto max-w-lg text-center">
      <p class="font-serif text-6xl text-brand-800">404</p>
      <h1 class="mt-4 text-2xl font-semibold tracking-tight text-slate-950 sm:text-3xl">This page is not here</h1>
      <p class="mt-3 text-base leading-relaxed text-slate-600">
        The address may have changed. The domain <strong class="font-semibold text-slate-900">finfulencers.com</strong> is still for sale.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/" class="inline-flex min-h-12 items-center justify-center rounded-full bg-brand-800 px-6 text-base font-semibold text-white">
          Back to the domain
        </a>
        <a href="/acquire/#inquire" class="inline-flex min-h-12 items-center justify-center rounded-full border border-slate-300 bg-white px-6 text-base font-semibold text-slate-800">
          Make an offer
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
