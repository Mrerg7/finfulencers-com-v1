---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page Not Found | Finfluencers"
  description="The requested page could not be found."
  canonical="https://finfulencers.com/404"
  noindex={true}
>
  <Header />
  <main class="flex-1 flex items-center justify-center px-4 min-h-[70svh] bg-white">
    <div class="text-center max-w-md mx-auto py-16">
      <p class="text-6xl font-bold text-brand-600 mb-4">404</p>
      <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mb-4">Page not found</h1>
      <p class="text-slate-600 mb-8 leading-relaxed">
        The page you’re looking for doesn’t exist or has been moved.
      </p>
      <a
        href="/"
        class="inline-flex items-center justify-center min-h-12 rounded-full bg-brand-600 px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-600/25 hover:bg-brand-700 transition-all"
      >
        Return Home
      </a>
    </div>
  </main>
  <Footer />
</Layout>
