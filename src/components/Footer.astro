---
import { mailto, nav, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-200 bg-brand-950 text-slate-300">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr] lg:px-8">
    <div>
      <p class="font-serif text-2xl text-white">finfulencers.com</p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-slate-400">
        A brandable .com beside the financial-influencer category. The domain is for sale.
        This site is a demonstration, not an operating advice business.
      </p>
      <a href={mailto} class="mt-5 inline-flex min-h-11 items-center text-sm font-semibold text-white underline decoration-white/30 underline-offset-4">
        {site.email}
      </a>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">On this site</p>
      <ul class="mt-4 space-y-1 text-sm">
        <li><a class="inline-flex min-h-11 items-center hover:text-white" href="/">Domain for sale</a></li>
        {
          nav.map((item) => (
            <li>
              <a class="inline-flex min-h-11 items-center hover:text-white" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a class="inline-flex min-h-11 items-center hover:text-white" href="/acquire/">Acquire the domain</a></li>
      </ul>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Acquisition</p>
      <ul class="mt-4 space-y-1 text-sm">
        <li><a class="inline-flex min-h-11 items-center hover:text-white" href="/acquire/#included">What is included</a></li>
        <li><a class="inline-flex min-h-11 items-center hover:text-white" href="/acquire/#process">Transfer process</a></li>
        <li><a class="inline-flex min-h-11 items-center hover:text-white" href="/faq/">Buyer FAQ</a></li>
        <li><a class="inline-flex min-h-11 items-center hover:text-white" href="/acquire/#inquire">Send an inquiry</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-6 text-xs leading-relaxed text-slate-500 sm:px-6 lg:px-8">
      <p>&copy; {year} Finfulencers. Domain for acquisition.</p>
      <p class="max-w-3xl">
        This website is for demonstration and general information. It is not financial, legal, or investment advice,
        and it is not an offer of securities or regulated services. Domain statistics are not implied. Public figures
        cited from regulators are attributed on the page where they appear and can change.
      </p>
    </div>
  </div>
</footer>
